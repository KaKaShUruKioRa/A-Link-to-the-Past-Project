dialog{
  id = "_treasure.dungeons/big_key.1",
  text = [[
Tu as la Grande Clé !$0 
Elle ouvre les verrous que les
Petites Clés ne peuvent ouvrir.
]],
}

dialog{
  id = "_treasure.dungeons/compass.1",
  text = [[
Tu as trouvé la Boussole !
Désormais tu peux repérer la 
planque du Diabolique Maître
du Donjon.
]],
}

dialog{
  id = "_treasure.dungeons/map.1",
  text = [[
Tu as le Plan ! Sers-t'en
