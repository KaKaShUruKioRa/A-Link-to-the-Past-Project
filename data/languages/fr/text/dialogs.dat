dialog{
  id = "NoBigKey",
  skip = "all",
  text = [[
Hein ? C'est fermé à clé !
Si tu avais une Grande Clé,
tu pourrais l'ouvrir.
]],
}

dialog{
  id = "NoRupees",
  text = [[
Tu ne peux pas l'ouvrir...  
Il te faut plus de Rubis pour ça !
]],
}

dialog{
  id = "NoSmallKey",
  text = [[
Tu ne peux pas l'ouvrir...  
Il te faut une petite clé pour ça !
]],
}

