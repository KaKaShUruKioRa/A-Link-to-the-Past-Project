]],
}

dialog{
  id = "_treasure.equipment/book_of_mudora.1",
  text = [[
Tu as trouvé le Livre de
Mudora !$0  Il te permet de
déchiffrer l'ancienne langue
des Hyliens !
]],
}

dialog{
  id = "_treasure.equipment/flippers.1",
  text = [[
Tu as trouvé les Palmes !$0 
Tu peux maintenant nager en eau
profonde !
]],
}

dialog{
  id = "_treasure.equipment/glove.1",
  text = [[
Tu as récupéré le Gant de la
Puissance !$0 Tu dois ressentir
la force dans tes mains.
]],
}

dialog{
  id = "_treasure.equipment/glove.2",
  text = [[
Tu as la Moufle du Titan !$0 Te
voilà maintenant capable de
soulever les lourdes pierres
noires qu'il était impossible
d'ébranler.
]],
}

dialog{
  id = "_treasure.equipment/moon_pearl.1",
  text = [[
Tu as trouvé la Perle de Lune !$0 
Elle protége le Héros des
effets changeants du
Pouvoir d'Or !
]],
}

dialog{
  id = "_treasure.equipment/pegasus_shoes.1",
  text = [[
Il t'a donné les Bottes de 
Pégase. Maintenant tu peux
lancer une Attaque Eclair
Dévastatrice ! Maintiens
appuyé le bouton Action
un court instant.
]],
}

dialog{
  id = "_treasure.equipment/shield.2",
  text = [[
Ton bouclier s'est amélioré !
Tu peux désormais te protéger
des boules de feu !
]],
}

dialog{
  id = "_treasure.equipment/shield.3",
  text = [[
Tu as trouvé le Bouclier
Miroir !$0  Tu peux désormais
réfléchir les rayons que ton
bouclier ne pouvait arrêter.

]],
}

dialog{
  id = "_treasure.equipment/sword.3",
  text = [[
Génial ! Ton épée est plus
puissante ! Sens la fabuleuse
force qui coule dans tes
veines.
]],
}

dialog{
  id = "_treasure.equipment/sword.4",
  text = [[
Ton épée est plus forte !
Tu peux sentir son pouvoir
couler dans tes mains !
]],
}

dialog{
  id = "_treasure.equipment/tunic.2",
  text = [[
Tu as trouvé la Cotte de Maille
