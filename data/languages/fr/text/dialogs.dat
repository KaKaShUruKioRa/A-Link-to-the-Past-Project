dialog{
  id = "NoBigKey",
  skip = "all",
  text = [[
Hein ? C'est fermé à clé !
Si tu avais une Grande Clé,
tu pourrais l'ouvrir.
]],
}

dialog{
  id = "NoRupees",
  text = [[
Tu ne peux pas l'ouvrir...  
Il te faut plus de Rubis pour ça !
]],
}

dialog{
  id = "NoSmallKey",
  text = [[
Tu ne peux pas l'ouvrir...  
Il te faut une petite clé pour ça !
]],
}

dialog{
  id = "_bush",
  text = [[
]],
}

dialog{
  id = "_crystal",
  text = [[
]],
}

dialog{
  id = "_shop.amount_full",
  text = [[
Tu ne peux en acheter plus !
Tu es déjà plein.
]],
}

dialog{
  id = "_shop.not_enough_money",
  text = [[
Tu n'as pas assez d'argent !
Qui essaies-tu d'arnaquer là ?...
]],
}

dialog{
  id = "_shop.question",
  text = [[
Prix : $v rubis.
           $? Acheter !
           $? Ne pas acheter !
]],
}

dialog{
  id = "_treasure.consumables/heart.1",
  text = [[
Vous obtenez un Coeur !
Il vous rend un coeur.
]],
}

dialog{
  id = "_treasure.consumables/piece_of_heart.1",
  text = [[
Vous obtenez un Quart de Coeur !


Lorsque vous en aurez rassemblé
quatre vous obtiendrez
un Coeur supplémentaire.
]],
}

dialog{
  id = "_treasure.consumables/rupee.1",
  text = [[
Tu as trouvé un Rubis Vert !
]],
}

dialog{
  id = "_treasure.consumables/rupee.2",
  text = [[
Tu as trouvé un Rubis Bleu !
Il vaut 5 Rubis Vert !
]],
}

dialog{
  id = "_treasure.consumables/rupee.3",
  text = [[
Tu as trouvé un Rubis Rouge !
Il vaut 20 Rubis Vert !
]],
}

dialog{
  id = "_treasure.consumables/rupee.4",
  text = [[
Tu as trouvé 50 Rubis !
]],
}

dialog{
  id = "_treasure.consumables/rupee.5",
  text = [[
Tu as trouvé 100 Rubis !
]],
}

dialog{
  id = "_treasure.consumables/rupee.6",
  text = [[
Tu as trouvé 300 Rubis !
]],
}

dialog{
  id = "_treasure.dungeons/big_key.1",
  text = [[
Tu as la Grande Clé ! $0
Elle ouvre les verrous que les
Petites Clés ne peuvent ouvrir.
]],
}

dialog{
  id = "_treasure.dungeons/compass.1",
  text = [[
Tu as trouvé la Boussole !
Désormais tu peux repérer la 
planque du Diabolique Maître
du Donjon.
]],
}

dialog{
  id = "_treasure.dungeons/map.1",
  text = [[
Tu as le Plan ! Sers-t'en
pour voir ta position
et le reste du donjon.
Appuie sur la touche {X}
]],
}

dialog{
  id = "_treasure.dungeons/small_key.1",
  skip = "all",
  text = [[
Tu as obtenu une petite clé !
Tu peux ouvrir des portes
fermées à clé !
]],
}

dialog{
  id = "_treasure.equipment/bombos_medallion.1",
  text = [[
This is the Bombos Medallion! $0
Its magic makes the ground
explode with power!
Watch your Magic Meter!
]],
}

dialog{
  id = "_treasure.equipment/book_of_mudora.1",
  text = [[
Tu as trouvé le Livre de
Mudora ! Il te permet de
déchiffrer l'ancienne langue
des Hyliens !
]],
}

dialog{
  id = "_treasure.equipment/cane_of_byrna.1",
  text = [[
You got the Cane Of Byrna! $0
If you swing it once, a ring of
light will protect you!
]],
}

dialog{
  id = "_treasure.equipment/cane_of_somaria.1",
  text = [[
You got the Cane Of Somaria! $0
It will be very helpful if you
make proper use of it!
What a mysterious cane!
]],
}

dialog{
  id = "_treasure.equipment/ether_medallion.1",
  text = [[
This is the Ether Medallion! $0
Its magic controls the upper
atmosphere and polar wind!
Watch your Magic Meter!
]],
}

dialog{
  id = "_treasure.equipment/fire_rod.1",
  text = [[
You found the Fire Rod! $0
This rod commands the red fire!
But watch your Magic Meter!
]],
}

dialog{
  id = "_treasure.equipment/flippers.1",
  text = [[
Tu as trouvé les Palmes !
Tu peux maintenant nager en eau
profonde !
]],
}

dialog{
  id = "_treasure.equipment/flute.1",
  text = [[
Oh! Here is the Flute! $0
Its music surely has some
mysterious power!
]],
}

dialog{
  id = "_treasure.equipment/glove.1",
  text = [[
Tu as récupéré le Gant de la
Puissance !$0 Tu dois ressentir
la force dans tes mains.
]],
}

dialog{
  id = "_treasure.equipment/glove.2",
  text = [[
You got the Titan's Mitt! $0
Now you can lift the heaviest
stones that were once
impossible to budge.
]],
}

dialog{
  id = "_treasure.equipment/hookshot.1",
  text = [[
BOING! This is the Hook Shot! $0
It extends and contracts and...
BOING! It can grapple many
things!
]],
}

dialog{
  id = "_treasure.equipment/moon_pearl.1",
  text = [[
Tu as trouvé la Perle de Lune ! $0
Elle protége le Héros des
effets changeants du
Pouvoir d'Or !
]],
}

dialog{
  id = "_treasure.equipment/pegasus_shoes.1",
  text = [[
Il t'a donné les Bottes de 
Pégase. Maintenant tu peux
lancer une Attaque Eclair
Dévastatrice ! Maintiens
appuyé le bouton Action
un court instant.
]],
}

dialog{
  id = "_treasure.equipment/quake_medallion.1",
  text = [[
This is the Quake Medallion! $0
Its magic causes the ground
to shake and defeats
nearby enemies!
Watch your Magic Meter!
]],
}

dialog{
  id = "_treasure.equipment/shield.1",
  text = [[
Tu as trouvé un Bouclier ! $0
]],
}

dialog{
  id = "_treasure.equipment/shield.2",
  text = [[
Your shield is improved!
Now you can defend yourself
against fireballs!
]],
}

dialog{
  id = "_treasure.equipment/shield.3",
  text = [[
You found the Mirror Shield!
You can now reflect beams
that your old shield
couldn't block!
]],
}

dialog{
  id = "_treasure.equipment/sword.3",
  text = [[
Your sword is tempered-up!
Now hold it!
]],
}

dialog{
  id = "_treasure.equipment/sword.4",
  text = [[
Your sword is stronger!
You can feel its power
throbbing in your hand!
]],
}

dialog{
  id = "_treasure.inventory/bombs.1",
  text = [[
Tu as les Bombes !
Tu peux ramasser et lancer 
la bombe que tu as placée.
Appuie sur le bouton Objet.
]],
}

dialog{
  id = "_treasure.inventory/boomerang.1",
  text = [[
Tu as le Boomerang ! $0Fais un
essai ! Pour choisir un objet,
appuie sur Pause.
]],
}

dialog{
  id = "_treasure.inventory/bottle_1.1",
  text = [[
Tu reçois un bocal vide !


Tu peux y stocker des choses
comme de l'eau, des abeilles, 
des graines, etc...
Mais aussi des potions et des fées !


Ha... et... il ne fonctionne pas, 
donc abandonne l'idée de t'en servir.
]],
}

dialog{
  id = "_treasure.inventory/bottle_2.1",
  text = [[
Tu reçois un bocal vide !


Tu peux y stocker des choses
comme de l'eau, des abeilles, 
des graines, etc...
Mais aussi des potions et des fées !
]],
}

dialog{
  id = "_treasure.inventory/bottle_3.1",
  text = [[
Tu reçois un bocal vide !


Tu peux y stocker des choses
comme de l'eau, des abeilles, 
des graines, etc...
Mais aussi des potions et des fées !
]],
}

dialog{
  id = "_treasure.inventory/bottle_4.1",
  text = [[
Tu reçois un bocal vide !


Tu peux y stocker des choses
comme de l'eau, des abeilles, 
des graines, etc...
Mais aussi des potions et des fées !
]],
}

dialog{
  id = "_treasure.inventory/bow.1",
  text = [[
Tu as trouvé l'Arc ! $0
Tu peux tirer des Flèches
jusqu'à ce que tu n'en aies plus.
]],
}

dialog{
  id = "_treasure.inventory/hammer.1",
  text = [[
You got the Magic Hammer! $0
You can drive the wooden
stakes down into the ground!
You can use it to pound on
other things too!
]],
}

dialog{
  id = "_treasure.inventory/ice_rod.1",
  text = [[
Tu as trouvé la Baguette de
Glace ! $0 Ses bourrasques
magiques glacent l'air.
Mais surveille ton Compteur 
Magique !
]],
}

dialog{
  id = "_treasure.inventory/lantern.1",
  skip = "all",
  text = [[
Tu as la Lanterne !
Maintenant tu peux allumer les
torches en appuyant
sur Objet pour te frayer
un chemin dans l'obscurité.
]],
}

dialog{
  id = "_treasure.inventory/magic_mirror.1",
  text = [[
Il t'a donné le Miroir Magique !
C'est un beau miroir bleu et
transparent !
On a l'impression qu'il va 
nous absorber dans un autre 
monde.
]],
}

dialog{
  id = "_treasure.quest/mushroom.1",
  text = [[
Mais... !?
]],
}

dialog{
  id = "_treasure.quest/pendant_of_courage.1",
  text = [[
Tu as gagné le Pendentif du
Courage ! Apporte-le à
Sahasrahla ! Il reste
encore deux Pendentifs !
]],
}

dialog{
  id = "_treasure.quest/pendant_of_power.1",
  text = [[
Tu as gagné le Pendentif du
Pouvoir ! $0
]],
}

dialog{
  id = "_treasure.quest/pendant_of_wisdom.1",
  text = [[
Tu as gagné le Pendentif de
Sagesse ! $0
]],
}

dialog{
  id = "a_utiliser_plus_tard._treasure/heart_receptable.1",
  text = [[
Tu as trouvé un réceptacle de 
coeur !
                {Coeur}
]],
}

dialog{
  id = "a_utiliser_plus_tard.out_of_magic",
  text = [[
Tu es à court de pouvoirs
magiques ! Tu ne peux pas
utiliser cet objet maintenant.
]],
}

dialog{
  id = "crypted.bombos_stele",
  text = [[
