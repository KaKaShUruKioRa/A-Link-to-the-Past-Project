]],
}

dialog{
  id = "_treasure.equipment/shield.2",
  text = [[
Your shield is improved!
Now you can defend yourself
against fireballs!
]],
}

dialog{
  id = "_treasure.equipment/shield.3",
  text = [[
You found the Mirror Shield!$0 
You can now reflect beams
that your old shield
couldn't block!
]],
}

dialog{
  id = "_treasure.equipment/sword.3",
  text = [[
Your sword is tempered-up!
Now hold it!
]],
}

dialog{
  id = "_treasure.equipment/sword.4",
  text = [[
Your sword is stronger!
You can feel its power
throbbing in your hand!
]],
}

dialog{
  id = "_treasure.equipment/tunic.2",
  text = [[
You found the Blue Mail!$0 
This armor reduces the damage
that you take from enemies!
]],
}

dialog{
  id = "_treasure.equipment/tunic.3",
  text = [[
You found the Red Mail!$0 
This provides even better
protection than the Blue Mail!
]],
}

dialog{
  id = "_treasure.inventory/bombos_medallion.1",
  text = [[
This is the Bombos Medallion!$0 
Its magic makes the ground
explode with power!
Watch your Magic Meter!
]],
}

dialog{
  id = "_treasure.inventory/bombs.1",
  text = [[
You got some Bombs!$0 
You can pick up and throw
a Bomb you placed
